# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=hms_db
PGUSER=hms_user
PGPASSWORD=change_this_password

# JWT
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# Default admin created if admins table is empty (first run only)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change_this_password
DEFAULT_ADMIN_NAME=System Administrator

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Gemini (get a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# true = send patient names as initials and phone numbers as last 4 digits to the AI
AI_MASK_PII=false

# for all start and stop command 
# net start postgresql-x64-18   to check - Get-Service postgresql-x64-18
# net stop postgresql-x64-18  /both for database
# cd backend && npm run dev
# cd frontend && npx serve . -p 8080
